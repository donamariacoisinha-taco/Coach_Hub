{
  "headers": [
    {
      "source": "/academia-sem-medo/assets/(.*).b64",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/academia-sem-medo/?", "dest": "/academia-sem-medo/index.html" },
    { "src": "/.*", "dest": "/" }
  ]
}
