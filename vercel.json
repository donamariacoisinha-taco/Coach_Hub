{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/academia-sem-medo/assets/(.*).b64",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(auth|onboarding|dashboard|workout|preparation|editor|history|admin|profile|library|dieta)(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/auth/?$", "dest": "/" },
    { "src": "/onboarding/?$", "dest": "/" },
    { "src": "/dashboard(?:/.*)?$", "dest": "/" },
    { "src": "/workout(?:/.*)?$", "dest": "/" },
    { "src": "/preparation(?:/.*)?$", "dest": "/" },
    { "src": "/editor(?:/.*)?$", "dest": "/" },
    { "src": "/history/?$", "dest": "/" },
    { "src": "/admin/?$", "dest": "/" },
    { "src": "/profile/?$", "dest": "/" },
    { "src": "/library/?$", "dest": "/" },
    { "src": "/dieta/?$", "dest": "/" }
  ]
}
