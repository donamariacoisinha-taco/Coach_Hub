# Supabase Configuration
# Never commit production credentials. Fill these in Vercel / local .env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gemini API Key
GEMINI_API_KEY=

# Local development only. Keep false/empty in preview, staging and production.
# When true, /api/intelligence accepts requests without a bearer token only while NODE_ENV is not production.
ALLOW_DEV_AI_AUTH_BYPASS=false

# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=
